# Copy this file to .env and fill in real values before running in production.
# IMPORTANT: Change NEO4J_AUTH before deploying — default credentials are insecure.
NEO4J_AUTH=neo4j/CHANGEME

# Model allow/deny list for the Anthropic /v1/messages endpoint. Allow lists
# take priority when both are set; deny always wins over allow. This example
# allows every model except the "fable" family.
HEADROOM_MODEL_ALLOWLIST_ENABLED=true
HEADROOM_MODEL_ALLOWLIST_DENY=["claude-fable*", "fable*"]
