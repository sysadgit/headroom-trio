# Copy this file to .env and fill in real values before running in production.
# IMPORTANT: Change NEO4J_AUTH before deploying — default credentials are insecure.
NEO4J_AUTH=neo4j/CHANGEME

# Model allow/deny list for the Anthropic /v1/messages endpoint. Allow lists
# take priority when both are set; deny always wins over allow. This example
# allows every model except the "fable" family.
HEADROOM_MODEL_ALLOWLIST_ENABLED=true
HEADROOM_MODEL_ALLOWLIST_DENY=["claude-fable*", "fable*"]

# Per-device tokens that unlock otherwise-denied models (e.g. Fable). No-op unless
# the token file exists. Manage with `headroom token add|list|revoke <device>`.
# Devices send the secret in the `x-headroom-device-token` header (stripped before
# the request goes upstream). Default file: $HEADROOM_CONFIG_DIR/device_tokens.json
# HEADROOM_DEVICE_TOKENS_FILE=/home/nonroot/.headroom/config/device_tokens.json
